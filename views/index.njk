{% import "macros/trailCard.njk" as macroTrail %}
{% extends "_base.njk" %}

{% block title %}All Trails{% endblock title %}

{% block main %}
  <h2>Trails</h2>
  {% if trails.length %}
    {% for trail in trails %}
      {{ macroTrail.trailCard(trail) }}
    {% endfor %}
  {% else %}
    <p>No trails found.</p>
  {% endif %}
{% endblock main %}
