{
	"name": "trail-guide",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "NODE_ENV=production tsx --env-file=.env src/app.ts",
		"dev": "tsx watch --env-file=.env src/app.ts",
		"typecheck": "tsc --noEmit",
		"db:seed": "sqlite3 data/trail-guide.db < data/seed.sql",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm lint && pnpm format:check && pnpm typecheck",
		"sync": "git switch main && git pull && pnpm install",
		"sync:branch": "git fetch origin && git merge --no-commit origin/main && pnpm install"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/nunjucks": "^3.2.6",
		"@types/sanitize-html": "^2.16.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-jinja-template": "^2.2.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2"
	},
	"dependencies": {
		"express": "^5.2.1",
		"nunjucks": "^3.2.4",
		"sanitize-html": "^2.17.6",
		"sqlite": "^5.1.1",
		"sqlite3": "^6.0.1",
		"tsx": "^4.23.15"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "24.x"
	}
}
