{
  "name": "trail-guide",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production tsx --env-file=.env src/app.ts",
    "dev": "tsx watch --env-file=.env src/app.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "sqlite3 data/trail-guide.db < data/seed.sql"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.16.1",
    "prettier-plugin-jinja-template": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nunjucks": "^3.2.4",
    "sanitize-html": "^2.17.6",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    }
  }
}
